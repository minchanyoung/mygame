# 예시 값만 기록한다. 실제 비밀값은 .env(커밋 금지)에 둔다.
API_PORT=3001
API_HOST=127.0.0.1
# 로컬 개발용 파일 저장소 위치 (PostgreSQL 연결 전 스텁)
RUN_STORE_DIR=.data/runs
# 1이면 플레이테스트 도구(상태 조정·사건 강제·정확한 확률 보기) 활성. NODE_ENV=production에서는 무시됨
PLAYTEST_TOOLS=0
# 추후 PostgreSQL 연결 시 사용 (현재 미사용)
# DATABASE_URL=postgresql://user:password@localhost:5432/company_life
